# 학생 설정 영역: Supabase Connect의 Session pooler 값을 넣는다.
# 이 예시 파일에는 실제 비밀번호나 키를 저장하지 않는다.
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD='YOUR_DATABASE_PASSWORD'
DB_SSLMODE=require
SECRET_KEY=CHANGE_ME_TO_A_NEW_RANDOM_SECRET
# 로컬 HTTP는 false, Render HTTPS는 true
SESSION_COOKIE_SECURE=false
# 일반/감시 서버에 같은 값을 사용한다. 브라우저에는 전달하지 않는다.
EVENT_TOKEN=CHANGE_ME_TO_A_SHARED_RANDOM_TOKEN
SENTRY_DSN=
SENTRY_ENVIRONMENT=mini-general
APP_VERSION=day2-v1
# 로그인한 상태에서 오류 확인 때만 true. 마무리할 때 false.
ENABLE_SENTRY_TEST=false
MONITOR_URL=https://YOUR_MONITOR_API.onrender.com/api/events
